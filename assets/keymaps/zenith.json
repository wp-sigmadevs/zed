// Zenith bindings, loaded after the base keymap so they apply in every keymap.
[
  {
    "context": "Workspace",
    "bindings": {
      // ⇧⇧ opens Search Everywhere, as in PhpStorm.
      "shift shift": "zenith_search::Toggle",
      // Find Action (⌘⇧A / Ctrl+Shift+A), as in PhpStorm.
      "secondary-shift-a": "zenith_search::FindAction",
      // Go to Class / File / Symbol and Recent Files, as in PhpStorm.
      "secondary-o": "zenith_search::GoToClass",
      "secondary-shift-o": "zenith_search::GoToFile",
      "secondary-alt-o": "zenith_search::GoToSymbol",
      "secondary-e": "zenith_search::RecentFiles",
      // Recent Locations, as in PhpStorm; the project panel keeps ⌘1.
      "secondary-shift-e": "zenith_search::RecentLocations",
      // PhpStorm's Switcher: hold ⌃, Tab to step, let go to open.
      "ctrl-tab": "zenith_search::Switcher",
      // TODO tool window. PhpStorm has no default key for it and gives ⌘6 to Problems, so ⇧ is added.
      "secondary-shift-6": "zenith_todo::ToggleFocus",
      // Problems tool window, as in PhpStorm (⌘6).
      "secondary-6": "zenith_problems::ToggleFocus",
      // WordPress Hooks tool window (WordPress projects only). PhpStorm has no key for it; free
      // in the macOS, Linux and JetBrains keymaps.
      "secondary-shift-7": "zenith_wordpress::ToggleWpHooksPanel",
      // Laravel tool window, routes and views (Laravel projects only). PhpStorm has no key for it;
      // ⌘⇧8 is free in the macOS, Linux and JetBrains keymaps.
      "secondary-shift-8": "zenith_laravel::ToggleLaravelPanel",
      // Next.js tool window, App Router routes (Next.js projects only). PhpStorm has no key for
      // it; ⌘⇧9 is unbound in the macOS, Linux and JetBrains keymaps.
      "secondary-shift-9": "zenith_nextjs::ToggleNextJsPanel",
      // Agent Review tool window (plan 23). Only the image viewer binds ⌘⇧0, in its own context.
      "secondary-shift-0": "zenith_agent_review::ToggleFocus",
      // New Scratch File, as in PhpStorm (⌘⇧N); overrides Go to File and New Window.
      "secondary-shift-n": "zenith_scratches::NewScratchFile",
      // Switch Project: the project switcher from the keyboard (⌘⌥⇧K). No JetBrains default
      // key; unbound in every base keymap.
      "secondary-alt-shift-k": "zenith_title_bar::ToggleProjectSwitcher",
      "secondary-shift-f": "zenith_search::FindInFiles",
      "secondary-shift-r": "zenith_search::ReplaceInFiles",
      // Show History (local history of the file), PhpStorm has no default key for it.
      "alt-shift-h": "zenith_local_history::ShowFileHistory",
      // Jump to Navigation Bar, as in PhpStorm (⌥Home); unbound in every base keymap.
      "alt-home": "zenith::JumpToNavigationBar",
    },
  },
  {
    // The history tab. Tab and Shift-Tab move between the revision list and the Revert and Copy
    // buttons. The base keymap has a context-less "tab" (menu::SelectNext) that would step the
    // list selection; a context-less binding ranks as the deepest context, so only a binding whose
    // context is the focused element's own (the list, or the tab's own area for the buttons) ties
    // with it, and being loaded later wins the tie.
    "context": "LocalHistoryList || LocalHistoryView",
    "bindings": {
      "tab": "zenith_local_history::FocusNextControl",
      "shift-tab": "zenith_local_history::FocusPreviousControl",
      "alt-shift-r": "zenith_local_history::RevertToRevision",
      "alt-shift-c": "zenith_local_history::CopyRevisionText",
    },
  },
  {
    // The Find in Files preview splitter, which is not an editor: the base keymap's context-less
    // "tab" (menu::SelectNext) would resize it. Same tie-break as the history block above.
    "context": "FindInFilesSplitter",
    "bindings": {
      "tab": "picker::ConfirmCompletion",
      "shift-tab": "zenith_search::FocusPreviousField",
    },
  },
  {
    // The PHP dialog. Tab and Shift-Tab move between its controls (level, interpreter, the list
    // toolbar, the buttons). The base keymap's context-less "tab" (menu::SelectNext) would step
    // the include list selection instead; same tie-break as the history tab above.
    "context": "ZenithPhpModal",
    "bindings": {
      "tab": "zenith_php_tools::FocusNextControl",
      "shift-tab": "zenith_php_tools::FocusPreviousControl",
    },
  },
  {
    // The PHP tools status popover. Tab and Shift-Tab move focus inside it (and wrap); without
    // this the base keymap's "tab" (menu::SelectNext) does nothing here, and Up/Down stay inert.
    "context": "ZenithPhpStatus",
    "bindings": {
      "tab": "zenith_php_tools::FocusNextControl",
      "shift-tab": "zenith_php_tools::FocusPreviousControl",
    },
  },
  {
    // Collapse / expand a hook in the WordPress Hooks tool window.
    "context": "WpHooksPanel",
    "bindings": {
      "left": "menu::SelectParent",
      "right": "menu::SelectChild",
    },
  },
  {
    // Routes / Views tabs of the Laravel tool window. Its list is flat, so left and right are
    // free; no default or JetBrains binding for them applies in this context.
    "context": "LaravelPanel",
    "bindings": {
      "left": "zenith_laravel::ShowRoutes",
      "right": "zenith_laravel::ShowViews",
    },
  },
  {
    // Filters (all / pages / route handlers) of the Next.js tool window. Its list is flat, so
    // left and right are free in this context.
    "context": "NextJsPanel",
    "bindings": {
      "left": "zenith_nextjs::PreviousFilter",
      "right": "zenith_nextjs::NextFilter",
    },
  },
  {
    // Agent Review tool window: the agent diff's own keep / reject keys, on the selected row.
    "context": "AgentReviewPanel",
    "bindings": {
      "secondary-y": "agent::Keep",
      "secondary-alt-z": "agent::Reject",
      "shift-alt-y": "agent::KeepAll",
      "shift-alt-z": "agent::RejectAll",
      // Same key as Revert in the Local History tab; shadows task::Spawn (Windows/Linux) here only.
      "shift-alt-r": "zenith_agent_review::RevertTurn",
    },
  },
  {
    // Collapse / expand a file in the Problems tool window.
    "context": "ProblemsPanel",
    "bindings": {
      "left": "menu::SelectParent",
      "right": "menu::SelectChild",
    },
  },
  {
    // Refresh in the Remote Host tool window, as PhpStorm's ⌘R in tool windows.
    "context": "RemoteHostPanel",
    "bindings": {
      "secondary-r": "zenith_deploy::Refresh",
    },
  },
  {
    // PhpStorm's Back / Forward through the navigation history (go to definition, search
    // results, recent places). Zed binds these keys to previous/next tab in "Pane", the
    // same depth, so they are repeated here where the later-loaded keymap wins.
    "context": "Pane",
    "bindings": {
      "secondary-alt-left": "pane::GoBack",
      "secondary-alt-right": "pane::GoForward",
      // PhpStorm's Find in Files and Replace in Files are popups, not a search tab.
      "secondary-shift-f": "zenith_search::FindInFiles",
      "secondary-shift-r": "zenith_search::ReplaceInFiles",
    },
  },
  {
    // The editor binds ⌘E (use selection for find) and ⌘⇧O (outline) itself, so
    // the same keys are repeated here, where they win.
    "context": "Editor && mode == full",
    "bindings": {
      "secondary-shift-o": "zenith_search::GoToFile",
      "secondary-e": "zenith_search::RecentFiles",
      // The JetBrains keymap binds ⌘⇧N (Go to File) in this context too.
      "secondary-shift-n": "zenith_scratches::NewScratchFile",
      // Refactor This, PhpStorm's Windows/Linux key. Its macOS key ⌃T is the editor's Transpose,
      // and F6, ⌘F6 and ⌘⌫ are Focus Next Part, Focus Next Part and Delete to End of Line, so
      // Move, Safe Delete and Change Signature are reached through this picker.
      "ctrl-alt-shift-t": "zenith_refactor::RefactorThis",
    },
  },
  {
    // Same key, same context string as the editor's "reveal in project panel",
    // which is two levels deep and would win over the rules above.
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "secondary-shift-e": "zenith_search::RecentLocations",
      // Show Usages popup (⌘⌥F7), as in PhpStorm; the JetBrains keymap's own binding
      // for these keys opens the usages in a tab, which the popup's button still does.
      "secondary-alt-f7": "zenith_search::ShowUsages",
    },
  },
  {
    // Tab / Shift-Tab switch Search Everywhere tabs, as in PhpStorm; arrows move
    // through results. Loaded last, so this beats the picker's own Tab.
    "context": "SearchEverywhere > Editor",
    "bindings": {
      "tab": "zenith_search::NextTab",
      "shift-tab": "zenith_search::PreviousTab",
      // Switcher: more ⌃Tab steps down the list, ⌃⇧Tab back up.
      "ctrl-tab": "zenith_search::Switcher",
      "ctrl-shift-tab": "menu::SelectPrevious",
    },
  },
  {
    // Find in Files toggles, as PhpStorm's Match Case, Words, Regex and File mask.
    // The query box is an Editor inside this context; no Editor binding uses these keys on macOS
    // or in the JetBrains keymaps (theirs are in BufferSearchBar and ProjectSearchBar).
    "context": "FindInFiles",
    "bindings": {
      "alt-c": "zenith_search::ToggleFindCase",
      "alt-w": "zenith_search::ToggleFindWord",
      "alt-x": "zenith_search::ToggleFindRegex",
      "alt-m": "zenith_search::ToggleFindMask",
    },
  },
  {
    // Postfix completion, Surround With and Live Templates (⌘⌥⇧X / ⌘⌥⇧T / ⌘⌥⇧J). PhpStorm's own keys
    // (⌘⌥T, ⌘J) are taken here by Close Other Tabs and the bottom dock; these three are unbound
    // in the macOS, Linux and Windows keymaps.
    "context": "Editor && mode == full",
    "bindings": {
      "secondary-alt-shift-x": "zenith_postfix::ExpandPostfix",
      "secondary-alt-shift-t": "zenith_postfix::SurroundWith",
      "secondary-alt-shift-j": "zenith_postfix::LiveTemplates",
    },
  },
  {
    // Run the request under the cursor in a .http file. Same depth as the editor's own ⌃Enter
    // (inline assist / new line), loaded later, so it wins. Run All and Select Environment
    // are command palette only.
    "context": "Editor && mode == full && extension == http",
    "bindings": {
      "ctrl-enter": "zenith_http::RunRequest",
    },
  },
  {
    // Owner's WebStorm customs (zed-config keymap.json), built in.
    "context": "Editor",
    "bindings": {
      "secondary-g": "go_to_line::Toggle",
      "alt-d": ["editor::SelectNext", { "replace_newest": false }],
      "secondary-shift-i": "assistant::InlineAssist",
    },
  },
  {
    // Navigation bar popups: left / right open the neighbouring segment's popup instead of a
    // submenu. Same depth as the base "menu" bindings, loaded later, so these win.
    "context": "NavigationBar > menu",
    "bindings": {
      "left": "zenith_navbar::SelectPreviousSegment",
      "right": "zenith_navbar::SelectNextSegment",
    },
  },
  {
    // Run Scratch, as in PhpStorm (⌃R), only in an editor showing a scratch file; elsewhere ⌃R
    // keeps its base-keymap action (Open Recent, Vim redo, ...).
    "context": "Editor && zenith_scratch",
    "bindings": {
      "ctrl-r": "zenith_scratches::RunScratch",
    },
  },
  {
    "context": "ScratchesPanel",
    "bindings": {
      "ctrl-r": "zenith_scratches::RunScratch",
    },
  },
  {
    // New PHP Class dialog: Tab and Shift-Tab move between its fields instead of typing a tab
    // into the focused one ("Editor" binds editor::Tab; this context is deeper, so it wins).
    "context": "ZenithNewPhpClass > Editor",
    "bindings": {
      "tab": "zenith_templates::NextField",
      "shift-tab": "zenith_templates::PreviousField",
    },
  },
]
