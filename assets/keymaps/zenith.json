// Zenith bindings, loaded after the base keymap so they apply in every keymap.
[
  {
    "context": "Workspace",
    "bindings": {
      // ⇧⇧ searches, as in PhpStorm.
      "shift shift": "file_finder::Toggle",
      // Find Action (⌘⇧A / Ctrl+Shift+A), as in PhpStorm.
      "secondary-shift-a": "zenith_search::Toggle",
    },
  },
]
