// Zenith bindings, loaded after the base keymap so they apply in every keymap.
[
  {
    "context": "Workspace",
    "bindings": {
      // ⇧⇧ opens Search Everywhere, as in PhpStorm.
      "shift shift": "zenith_search::Toggle",
      // Find Action (⌘⇧A / Ctrl+Shift+A), as in PhpStorm.
      "secondary-shift-a": "zenith_search::FindAction",
    },
  },
  {
    // Tab / Shift-Tab switch Search Everywhere tabs, as in PhpStorm; arrows move
    // through results. Loaded last, so this beats the picker's own Tab.
    "context": "SearchEverywhere > Editor",
    "bindings": {
      "tab": "zenith_search::NextTab",
      "shift-tab": "zenith_search::PreviousTab",
    },
  },
]
